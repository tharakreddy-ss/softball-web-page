# Copy to .env.local and fill in values (never commit .env.local)

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# Auth
JWT_SECRET=your-secret-key-min-32-chars

# Cloudinary (https://console.cloudinary.com)
# Option A: single URL (recommended)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# Option B: separate vars (used if CLOUDINARY_URL is unset)
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Google Maps (https://console.cloud.google.com/google/maps-apis)
GOOGLE_MAPS_API_KEY=<api_key>
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<api_key>
